    <!-- Application Logic & Interactive Charts -->
    <script>
        let currentLang = 'es';
        let genreChartInstance = null;
        let reachChartInstance = null;

        document.addEventListener('DOMContentLoaded', () => {
            initCharts();
        });

        // Toggle Language Logic
        function setLanguage(lang) {
            currentLang = lang;
            const bioEs = document.getElementById('bio-es');
            const bioEn = document.getElementById('bio-en');
            const btnEs = document.getElementById('nav-btn-es');
            const btnEn = document.getElementById('nav-btn-en');

            if (lang === 'es') {
                bioEs.classList.remove('hidden');
                bioEn.classList.add('hidden');
                btnEs.className = 'px-2.5 py-1 text-[10px] font-display font-bold rounded border border-electric-cyan text-electric-cyan';
                btnEn.className = 'px-2.5 py-1 text-[10px] font-display font-bold rounded border border-slate-700 text-slate-400';
            } else {
                bioEs.classList.add('hidden');
                bioEn.classList.remove('hidden');
                btnEn.className = 'px-2.5 py-1 text-[10px] font-display font-bold rounded border border-electric-cyan text-electric-cyan';
                btnEs.className = 'px-2.5 py-1 text-[10px] font-display font-bold rounded border border-slate-700 text-slate-400';
            }
        }

        // Initialize Canvas Chart.js
        function initCharts() {
            // Chart 1: Genre Breakdown (Doughnut)
            const ctxGenre = document.getElementById('genreChart').getContext('2d');
            genreChartInstance = new Chart(ctxGenre, {
                type: 'doughnut',
                data: {
                    labels: ['Tech House', 'Minimal Groove', 'Deep Underground', 'Hypnotic Tech'],
                    datasets: [{
                        data: [45, 30, 15, 10],
                        backgroundColor: ['#38BDF8', '#3B82F6', '#1E293B', '#0284C7'],
                        borderColor: '#0B0F19',
                        borderWidth: 3
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { color: '#CBD5E1', font: { family: 'Plus Jakarta Sans', size: 11 } }
                        },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.label + ': ' + context.raw + '% del Set';
                                }
                            }
                        }
                    }
                }
            });

            // Chart 2: Performance Reach (Bar Chart)
            const ctxReach = document.getElementById('reachChart').getContext('2d');
            reachChartInstance = new Chart(ctxReach, {
                type: 'bar',
                data: {
                    labels: ['Medellín (Viuz/Sonorama)', 'Bogotá / Colombia', 'Miami (EE.UU.)', 'Buenos Aires (ARG)'],
                    datasets: [{
                        label: 'Presentaciones & Residencias',
                        data: [65, 15, 10, 10],
                        backgroundColor: '#38BDF8',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { color: '#94A3B8' },
                            grid: { color: 'rgba(56, 189, 248, 0.1)' }
                        },
                        x: {
                            ticks: { 
                                color: '#94A3B8',
                                callback: function(val, index) {
                                    let label = this.getLabelForValue(val);
                                    return label.length > 16 ? label.substr(0, 16) + '...' : label;
                                }
                            },
                            grid: { display: false }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        // Lightbox Handler
        function openLightbox(src, caption) {
            document.getElementById('lightbox-img').src = src;
            document.getElementById('lightbox-caption').innerText = caption || 'LA JEFA - Official Press Shot';
            document.getElementById('lightbox').classList.remove('hidden');
        }

        function closeLightbox() {
            document.getElementById('lightbox').classList.add('hidden');
        }

        // Rider Checklist Logic
        function toggleRiderItem(checkbox) {
            const checkboxes = document.querySelectorAll('#rider input[type="checkbox"]');
            let checkedCount = 0;
            checkboxes.forEach(cb => { if (cb.checked) checkedCount++; });

            const statusText = document.getElementById('rider-status-text');
            statusText.innerText = `${checkedCount} de ${checkboxes.length} Equipos Confirmados`;
            if (checkedCount === checkboxes.length) {
                statusText.className = "text-emerald-400 font-bold";
            } else {
                statusText.className = "text-electric-cyan";
            }
        }

        function resetRiderChecklist() {
            const checkboxes = document.querySelectorAll('#rider input[type="checkbox"]');
            checkboxes.forEach(cb => cb.checked = false);
            toggleRiderItem();
        }

        // Custom WhatsApp Builder
        function sendCustomWhatsApp() {
            const name = document.getElementById('booking-name').value || 'Un Promotor';
            const city = document.getElementById('booking-city').value || 'Ciudad por confirmar';
            const date = document.getElementById('booking-date').value || 'Fecha a definir';

            const message = `Hola La Jefa, mi nombre es ${name}. Nos interesa solicitar cotización e información para un evento en ${city} con fecha estimativa ${date}.`;
            const encoded = encodeURIComponent(message);
            window.open(`https://wa.me/573004311749?text=${encoded}`, '_blank');
        }
    </script>
